# RocketMQ Studio Docker Environment
# Remote deployment target
REMOTE_HOST=your-server-ip
REMOTE_USER=root
REMOTE_PATH=/opt/rocketmq-studio

# Optional local server build settings. deploy.sh mounts this directory into
# the Maven build container, so downloaded dependencies persist across builds.
# MAVEN_CACHE_DIR=/home/your-user/.m2
# MAVEN_IMAGE=maven:3.9.9-eclipse-temurin-21

# Frontend public port
PUBLIC_PORT=6789

# Login is required by default, including during first-time setup.
STUDIO_AUTH_LOGIN_REQUIRED=true
# Before first use with an empty database, set BOTH values to an operator-chosen
# username and a unique password. There is no built-in bootstrap account.
# The first login seeds the configured account into rmq_studio_user while login
# protection stays enabled. If either value is blank, login fails closed.
# Once users exist, the database is authoritative: changing these variables does
# not reset existing accounts. Use Studio user management to change them.
STUDIO_AUTH_ADMIN_USERNAME=
STUDIO_AUTH_ADMIN_PASSWORD=

# Keep true when browsers access Studio through HTTPS (including TLS termination
# at a reverse proxy). For local HTTP development only, explicitly set false.
STUDIO_AUTH_SESSION_COOKIE_SECURE=true

# Optional Prometheus-compatible data source for the built-in metrics proxy.
# `deploy/rocketmq/docker-compose.yml` ships a `rocketmq-prometheus` container on the
# shared `rocketmq_net` network that scrapes both brokers, so the container name below
# works as-is once that stack is up. Do not use localhost/127.0.0.1: UrlHostGuard blocks
# loopback for metrics data sources and the query fails with "base URL is invalid".
STUDIO_METRICS_PROMETHEUS_BASE_URL=http://rocketmq-prometheus:9090
STUDIO_METRICS_PROMETHEUS_USERNAME=
STUDIO_METRICS_PROMETHEUS_PASSWORD=
STUDIO_METRICS_PROMETHEUS_BEARER_TOKEN=

# Optional comma-separated environment variable names that CLI-backed AI
# providers may inherit in addition to Studio's minimal built-in allowlist.
# Values are read from the rocketmq-server environment; do not list unrelated
# server secrets here.
RMQ_LLM_CLI_ALLOWED_ENVIRONMENT=

# ─────────────────────────────────────────────────────────────────────────────
# ⚠️ Putting a variable in this file is NOT enough on its own.
# docker compose only forwards what the service's `environment:` block declares,
# so every variable below must also appear in deploy/docker-compose.yml as
# `NAME: ${NAME:-}`. A variable present here but missing there silently never
# reaches the container. That exact gap took MCP authentication down on a live
# deployment (every call returned 401) while /api/topics kept returning 200,
# because that endpoint serves Studio's own metadata rows and needs no
# credential — so it masks the failure. Verify with:
#   docker exec rocketmq-server printenv SPRING_APPLICATION_JSON
# ─────────────────────────────────────────────────────────────────────────────

# LLM gateway credential for the CLI-backed engines (claude-code / qoder).
# RMQ_LLM_TOKEN takes precedence over the api key stored in rmq_settings, so a
# key saved through the settings page is dead config while this is set.
# When RMQ_ANTHROPIC_BASE_URL is set it is used verbatim; when it is blank,
# ClaudeCodeAgentProvider derives the Anthropic base from the configured apiBase
# by rewriting a trailing /compatible-mode/v1 into /apps/anthropic.
RMQ_LLM_TOKEN=
RMQ_ANTHROPIC_BASE_URL=

# MCP server (endpoint /api/mcp, consumed by rmqctl and by external agents).
# STUDIO_AI_TOKEN_SECRET signs the confirm tokens used by the L2/L3 mutation
# preview/apply flow. Leave it blank and every mutation tool answers
# "UNAVAILABLE: Tool confirmation tokens are unavailable". Must be base64 of at
# least 32 bytes after decoding. Generate one with: openssl rand -base64 32
STUDIO_AI_TOKEN_SECRET=
# Gate for L3 (high-risk) tools. Defaults to false, so a hosted agent cannot run
# them unless this is explicitly turned on.
STUDIO_AI_ALLOW_L3_TOOLS=false

# Admin credentials for open-source (vendor=APACHE) instances, keyed by the
# credential ref stored in rmq_instance.admin_credential_ref. This is how the
# instance bound to a conversation authenticates to its broker, and it is also
# the secret rmqctl signs its HMAC requests with. Inject it only through this
# environment variable — never commit real credentials.
# Shape (single line, valid JSON):
#   {"studio":{"cluster":{"admin":{"credentials":{"<ref>":{"accessKey":"<ak>","secretKey":"<sk>"}}}}}}
SPRING_APPLICATION_JSON=

# AI conversation persistence, retention and the hosted-agent workspace.
# All optional; these are the defaults.
# STUDIO_AI_CONVERSATION_RETENTION_DAYS=90
# STUDIO_AI_CONVERSATION_CLEANUP_BATCH_SIZE=500
# STUDIO_AI_CONVERSATION_CLEANUP_MAX_BATCHES=20
# STUDIO_AI_CONVERSATION_CLEANUP_INTERVAL=PT24H
# STUDIO_AI_CONVERSATION_ORPHAN_RUN_TIMEOUT=PT10M
# STUDIO_AI_CONVERSATION_STOP_GRACE=PT3S
# Per-conversation agent workspace root. Holds rmqctl.yaml, mcp.json and the
# HOME directory the agent CLI needs for --resume. NOTE: a container restart
# wipes /tmp, which invalidates resumable sessions; the server detects that and
# retries once without --resume. Mount a volume here to keep sessions across
# restarts.
# STUDIO_AI_CONVERSATION_WORKSPACE_DIR=/tmp/rocketmq-studio-ai
# Set to false to run the agent without RocketMQ tools (plain chat). Also falls
# back to this automatically when the rmqctl binary is absent.
# STUDIO_AI_RMQCTL_ENABLED=true
# Blank means "derive from server.port on loopback", which is what you want:
# rmqctl rejects plain HTTP for any non-loopback host. Only set this to an
# https URL when rmqctl runs somewhere other than inside the server container.
# STUDIO_AI_RMQCTL_SERVER_URL=
# STUDIO_AI_RMQCTL_TIMEOUT=PT60S
